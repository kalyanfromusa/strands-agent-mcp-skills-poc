# Ignore file for mcp_servers/support_mcp/Dockerfile (BuildKit picks up <Dockerfile>.dockerignore).
# The build context is the repo root, so allow-list only what the image needs.
*
!mcp_servers/support_mcp/requirements.txt
!mcp_servers/support_mcp/server.py
!mcp_servers/support_mcp/faq.json
!mcp_servers/common/*.py
